<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>محاكاة البندول الفيزيائي</title>
    <style>
        :root {
            --primary: #4285f4;
            --secondary: #34a853;
            --accent: #ea4335;
            --dark: #202124;
            --light: #f8f9fa;
        }
        
        body {
            font-family: 'Tajawal', sans-serif;
            background: #f5f5f5;
            margin: 0;
            padding: 20px;
            color: var(--dark);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        
        .container {
            width: 100%;
            max-width: 900px;
            background: white;
            padding: 30px;
            border-radius: 15px;
            margin: auto;
        }
        
        h1 {
            color: var(--primary);
            text-align: center;
            margin-bottom: 30px;
            position: relative;
            padding-bottom: 15px;
        }
        
        h1::after {
            content: "";
            display: block;
            width: 100px;
            height: 4px;
            background: linear-gradient(to right, var(--primary), var(--secondary));
            margin: 15px auto 0;
            border-radius: 2px;
        }
        
        .controls {
            background: var(--light);
            padding: 20px;
            border-radius: 12px;
            margin-bottom: 20px;
        }
        
        .control-group {
            display: flex;
            align-items: center;
            margin: 15px 0;
            flex-wrap: wrap;
            gap: 10px;
        }
        
        label {
            font-weight: bold;
            width: 150px;
            text-align: right;
        }
        
        input[type="range"] {
            flex: 1;
            min-width: 200px;
            height: 10px;
            -webkit-appearance: none;
            background: #e0e0e0;
            border-radius: 5px;
            outline: none;
        }
        
        input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 22px;
            height: 22px;
            border-radius: 50%;
            background: var(--primary);
            cursor: pointer;
        }
        
        .value-display {
            background: white;
            padding: 6px 12px;
            border-radius: 5px;
            font-weight: bold;
            min-width: 70px;
            text-align: center;
        }
        
        .button-group {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-top: 25px;
            flex-wrap: wrap;
        }
        
        button {
            padding: 12px 24px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: opacity 0.3s;
        }
        
        #startBtn { background: var(--secondary); color: white; }
        #pauseBtn { background: var(--accent); color: white; }
        #resetBtn { background: var(--dark); color: white; }
        
        button:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }
        
        .simulation-container {
            background: white;
            padding: 15px;
            border-radius: 10px;
            margin: 20px 0;
        }
        
        canvas {
            background: white;
            display: block;
            margin: 0 auto;
            max-width: 100%;
        }
        
        .info-panel {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin: 20px 0;
        }
        
        .info-item {
            background: var(--light);
            padding: 15px;
            border-radius: 8px;
            text-align: center;
        }
        
        .info-value {
            font-size: 1.3rem;
            font-weight: bold;
            color: var(--primary);
            margin-top: 5px;
        }
        
        .progress-container {
            height: 5px;
            background: #e0e0e0;
            border-radius: 5px;
            margin: 15px 0;
            overflow: hidden;
        }
        
        .progress-bar {
            height: 100%;
            background: linear-gradient(to right, var(--secondary), var(--primary));
            width: 0%;
            transition: width 0.3s;
        }
        
        footer {
            text-align: center;
            margin-top: 20px;
            color: #666;
            font-size: 0.9rem;
        }

        @media (max-width: 768px) {
            .container {
                padding: 15px;
            }
            
            .control-group {
                flex-direction: column;
                align-items: stretch;
            }
            
            label {
                text-align: center;
                width: 100%;
            }
        }
    </style>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700&display=swap" rel="stylesheet">
</head>
<body>
    <div class="container">
        <h1>محاكاة البندول الفيزيائي</h1>
        
        <div class="controls">
            <div class="control-group">
                <label for="frequency">التردد (هرتز):</label>
                <input type="range" id="frequency" min="0.1" max="2" step="0.1" value="1">
                <span id="frequencyValue" class="value-display">1.0</span>
            </div>
            
            <div class="control-group">
                <label for="amplitude">السعة (درجات):</label>
                <input type="range" id="amplitude" min="5" max="90" step="1" value="45">
                <span id="amplitudeValue" class="value-display">45</span>
            </div>
            
            <div class="control-group">
                <label for="oscillations">عدد الاهتزازات:</label>
                <input type="range" id="oscillations" min="1" max="20" step="1" value="5">
                <span id="oscillationsValue" class="value-display">5</span>
            </div>
            
            <div class="progress-container">
                <div id="progressBar" class="progress-bar"></div>
            </div>
            
            <div class="button-group">
                <button id="startBtn">بدء المحاكاة</button>
                <button id="pauseBtn" disabled>إيقاف مؤقت</button>
                <button id="resetBtn" disabled>إعادة تعيين</button>
            </div>
        </div>
        
        <div class="simulation-container">
            <canvas id="pendulumCanvas" width="700" height="400"></canvas>
        </div>
        
        <div class="info-panel">
            <div class="info-item">
                <div>الزمن المنقضي</div>
                <div id="elapsedTime" class="info-value">0.00 ثانية</div>
            </div>
            <div class="info-item">
                <div>الزاوية الحالية</div>
                <div id="currentAngle" class="info-value">0.00°</div>
            </div>
            <div class="info-item">
                <div>عدد الاهتزازات</div>
                <div id="oscillationCounter" class="info-value">0</div>
            </div>
        </div>
    </div>

    <footer>
        تم تطوير هذا المشروع لأغراض تعليمية | © 2023
    </footer>

    <script>
        // العناصر الأساسية
        const canvas = document.getElementById('pendulumCanvas');
        const ctx = canvas.getContext('2d');
        const freqSlider = document.getElementById('frequency');
        const ampSlider = document.getElementById('amplitude');
        const oscSlider = document.getElementById('oscillations');
        const startBtn = document.getElementById('startBtn');
        const pauseBtn = document.getElementById('pauseBtn');
        const resetBtn = document.getElementById('resetBtn');
        const progressBar = document.getElementById('progressBar');
        
        // المتغيرات
        let frequency = parseFloat(freqSlider.value);
        let amplitude = parseFloat(ampSlider.value);
        let oscillations = parseInt(oscSlider.value);
        const length = 200;
        const PI = Math.PI;
        let angle = 0;
        let time = 0;
        let animationId = null;
        let isRunning = false;
        let startTime = 0;
        let currentOscillations = 0;
        
        // تحديث القيم
        function updateValues() {
            frequency = parseFloat(freqSlider.value);
            amplitude = parseFloat(ampSlider.value);
            oscillations = parseInt(oscSlider.value);
            
            document.getElementById('frequencyValue').textContent = frequency.toFixed(1);
            document.getElementById('amplitudeValue').textContent = amplitude;
            document.getElementById('oscillationsValue').textContent = oscillations;
        }
        
        // رسم البندول
        function drawPendulum() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            
            const centerX = canvas.width / 2;
            const centerY = 100;
            const maxAngle = amplitude * PI / 180;
            angle = maxAngle * Math.sin(2 * PI * frequency * time);
            
            const bobX = centerX + length * Math.sin(angle);
            const bobY = centerY + length * Math.cos(angle);
            
            // رسم الخيط
            ctx.beginPath();
            ctx.moveTo(centerX, centerY);
            ctx.lineTo(bobX, bobY);
            ctx.strokeStyle = '#555';
            ctx.lineWidth = 3;
            ctx.stroke();
            
            // رسم الكتلة
            ctx.beginPath();
            ctx.arc(bobX, bobY, 25, 0, 2 * PI);
            ctx.fillStyle = '#4285f4';
            ctx.fill();
            
            // رسم نقطة التعليق
            ctx.beginPath();
            ctx.arc(centerX, centerY, 8, 0, 2 * PI);
            ctx.fillStyle = '#ea4335';
            ctx.fill();
            
            // تحديث المعلومات
            document.getElementById('elapsedTime').textContent = time.toFixed(2) + ' ثانية';
            document.getElementById('currentAngle').textContent = (angle * 180 / PI).toFixed(2) + '°';
            document.getElementById('oscillationCounter').textContent = currentOscillations;
            
            // شريط التقدم
            const progress = (time * frequency) / oscillations * 100;
            progressBar.style.width = `${Math.min(100, progress)}%`;
        }
        
        // المحاكاة
        function simulate(timestamp) {
            if (!startTime) startTime = timestamp;
            
            time = (timestamp - startTime) / 1000;
            
            // حساب الاهتزازات
            currentOscillations = Math.floor(time * frequency);
            
            if (currentOscillations >= oscillations) {
                stopSimulation();
                return;
            }
            
            drawPendulum();
            
            if (isRunning) {
                animationId = requestAnimationFrame(simulate);
            }
        }
        
        function startSimulation() {
            isRunning = true;
            startTime = 0;
            startBtn.disabled = true;
            pauseBtn.disabled = false;
            resetBtn.disabled = false;
            animationId = requestAnimationFrame(simulate);
        }
        
        function stopSimulation() {
            isRunning = false;
            cancelAnimationFrame(animationId);
            startBtn.disabled = false;
            pauseBtn.disabled = true;
        }
        
        function resetSimulation() {
            stopSimulation();
            time = 0;
            currentOscillations = 0;
            progressBar.style.width = '0%';
            drawPendulum();
        }
        
        // الأحداث
        freqSlider.addEventListener('input', updateValues);
        ampSlider.addEventListener('input', updateValues);
        oscSlider.addEventListener('input', updateValues);
        
        startBtn.addEventListener('click', startSimulation);
        pauseBtn.addEventListener('click', stopSimulation);
        resetBtn.addEventListener('click', resetSimulation);
        
        // التهيئة الأولية
        updateValues();
        drawPendulum();
    </script>
</body>
</html>